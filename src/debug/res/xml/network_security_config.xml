<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the emulator sandbox test reach its loopback listener over plain HTTP, so
     a refused request proves the sandbox and not the app-wide cleartext ban. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
