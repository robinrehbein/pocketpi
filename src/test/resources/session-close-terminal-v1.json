{
  "version": 1,
  "capability": "session.close.terminal.v1",
  "wireValid": [
    {
      "name": "terminal-session-idle",
      "payload": {
        "type": "result",
        "requestId": "host_worker.v1:list-1",
        "ok": true,
        "data": {
          "kind": "sessions",
          "items": [
            {
              "id": "terminal-session",
              "projectId": "project",
              "title": "Fix",
              "origin": "tui",
              "status": "idle"
            }
          ]
        }
      }
    },
    {
      "name": "close",
      "payload": {
        "type": "session.close",
        "requestId": "close:1",
        "projectId": "project",
        "sessionId": "terminal-session"
      }
    },
    {
      "name": "close-accepted",
      "payload": {
        "type": "result",
        "requestId": "close:1",
        "ok": true,
        "data": { "kind": "accepted", "sessionId": "terminal-session" }
      }
    },
    {
      "name": "close-busy",
      "payload": {
        "type": "result",
        "requestId": "close:1",
        "ok": false,
        "error": { "code": "busy", "message": "Session is busy" }
      }
    },
    {
      "name": "close-draft",
      "payload": {
        "type": "result",
        "requestId": "close:1",
        "ok": false,
        "error": { "code": "busy", "message": "Unsent text in the Mac editor" }
      }
    },
    {
      "name": "close-unsupported",
      "payload": {
        "type": "result",
        "requestId": "close:1",
        "ok": false,
        "error": {
          "code": "unsupported",
          "message": "Reload the pi remote extension to use this control"
        }
      }
    },
    {
      "name": "close-offline",
      "payload": {
        "type": "result",
        "requestId": "close:1",
        "ok": false,
        "error": { "code": "offline", "message": "Session is offline" }
      }
    },
    {
      "name": "close-result-unknown",
      "payload": {
        "type": "result",
        "requestId": "close:1",
        "ok": false,
        "error": { "code": "internal", "message": "Close result unknown; refresh" }
      }
    }
  ],
  "wireInvalid": [
    {
      "name": "close-extra-key",
      "payload": {
        "type": "session.close",
        "requestId": "close:1",
        "projectId": "project",
        "sessionId": "terminal-session",
        "force": true
      }
    },
    {
      "name": "close-missing-project",
      "payload": {
        "type": "session.close",
        "requestId": "close:1",
        "sessionId": "terminal-session"
      }
    },
    {
      "name": "close-accepted-extra-key",
      "payload": {
        "type": "result",
        "requestId": "close:1",
        "ok": true,
        "data": { "kind": "accepted", "sessionId": "terminal-session", "closed": true }
      }
    }
  ]
}
